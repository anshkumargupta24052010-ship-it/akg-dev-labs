rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'anshkumargupta24052010@gmail.com';
    }

    match /akgSiteData/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedbackEntries/{feedbackId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.company is string
        && request.resource.data.post is string
        && request.resource.data.message is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.status == 'pending'
        && request.resource.data.displayStyle == 'horizontal';
      allow update, delete: if isAdmin();
    }
  }
}
